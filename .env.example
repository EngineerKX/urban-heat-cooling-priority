# copy this file to .env and fill in your own credentials — never commit .env itself
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=
GEE_PROJECT_ID=nus-iss-urban-heat-sg
# GCS bucket for U-Net/CNN TFRecord patch export/import (see src/ingest/gee.py
# export_patches_to_gcs). Leave blank if you're not training U-Net/CNN yet.
GEE_EXPORT_BUCKET=
# Optional: separate bucket for trained-model sync (scripts/pull_models.py /
# push_models.py) and Colab training-run summaries. Leave unset to reuse
# GEE_EXPORT_BUCKET (the default, and fine for this project's scale).
GCS_MODEL_BUCKET=